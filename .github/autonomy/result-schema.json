{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "probe",
        "planned",
        "progress",
        "completed",
        "blocked",
        "no_change"
      ]
    },
    "summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "content": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "path",
          "content"
        ]
      }
    },
    "tickets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "enum": [
              0,
              1,
              2
            ]
          },
          "ready": {
            "type": "boolean"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "required": [
          "key",
          "title",
          "body",
          "priority",
          "ready",
          "depends_on"
        ]
      }
    }
  },
  "required": [
    "outcome",
    "summary",
    "evidence",
    "files",
    "tickets"
  ]
}
